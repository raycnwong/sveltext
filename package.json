{
	"name": "sveltext",
	"version": "0.1.2",
	"description": "A compiled, Svelte-first i18n library with Gettext-like syntax and ICU plurals.",
	"keywords": [
		"i18n",
		"vite",
		"svelte",
		"sveltekit",
		"gettext",
		"icu"
	],
	"license": "MIT",
	"author": "Ray Wong",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/raycnwong/sveltext.git"
	},
	"bin": {
		"sveltext": "./src/cli.ts"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./vite": {
			"types": "./src/vite.ts",
			"default": "./src/vite.ts"
		},
		"./internal": {
			"types": "./src/internal.ts",
			"default": "./src/internal.ts"
		}
	},
	"publishConfig": {
		"bin": {
			"sveltext": "./dist/cli.js"
		},
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./internal": {
				"types": "./dist/internal.d.ts",
				"default": "./dist/internal.js"
			}
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && cp ./src/*.svelte ./dist",
		"test": "pnpm --filter sveltext-tests build && pnpm --filter sveltext-tests e2e",
		"format": "prettier --write ./src",
		"typecheck": "tsc --noEmit",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish"
	},
	"dependencies": {
		"@formatjs/icu-messageformat-parser": "^3.5.1",
		"@sveltejs/acorn-typescript": "^1.0.9",
		"acorn": "^8.16.0",
		"commander": "^14.0.3",
		"gettext-parser": "^9.0.1",
		"magic-string": "^0.30.21",
		"zimmerframe": "^1.1.4"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.6.0",
		"@changesets/cli": "^2.30.0",
		"@types/gettext-parser": "^9.0.0",
		"@types/node": "^24.10.13",
		"prettier": "^3.8.1",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0",
		"vite": ">=5.0.0"
	},
	"packageManager": "pnpm@10.28.2"
}
