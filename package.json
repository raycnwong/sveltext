{
	"name": "sveltext",
	"version": "0.4.3",
	"description": "A compiled, Svelte-first i18n library with Gettext-like syntax and ICU plurals.",
	"keywords": [
		"i18n",
		"vite",
		"svelte",
		"sveltekit",
		"gettext",
		"icu"
	],
	"license": "MIT",
	"author": "Ray Wong",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/raycnwong/sveltext.git"
	},
	"bin": {
		"sveltext": "./src/cli.ts"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./vite": {
			"types": "./src/vite.ts",
			"default": "./src/vite.ts"
		},
		"./server": {
			"types": "./src/server.ts",
			"default": "./src/server.ts"
		}
	},
	"publishConfig": {
		"bin": {
			"sveltext": "./dist/cli.js"
		},
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./server": {
				"types": "./dist/server.d.ts",
				"default": "./dist/server.js"
			}
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && cp ./src/*.svelte ./dist",
		"test": "pnpm test:build && pnpm --filter sveltext-tests e2e",
		"test:build": "pnpm --filter sveltext-tests build",
		"format": "prettier --write ./{src,tests}",
		"typecheck": "tsc --noEmit",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish"
	},
	"dependencies": {
		"@formatjs/icu-messageformat-parser": "^3.5.22",
		"@sveltejs/acorn-typescript": "^1.0.13",
		"acorn": "^8.19.0",
		"commander": "^15.0.0",
		"gettext-parser": "^10.0.0",
		"magic-string": "^1.4.5",
		"zimmerframe": "^1.1.5"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@types/gettext-parser": "^9.0.0",
		"@types/node": "^24.19.2",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"svelte": ">=5.0.0",
		"vite": ">=5.0.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@10.28.2"
}
