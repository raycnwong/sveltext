		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"sveltext": "latest",
		"@sveltejs/adapter-node": "^6.0.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"sveltekit-superforms": "^3.1.0",
		"zod": "^4.6.7"
	}
